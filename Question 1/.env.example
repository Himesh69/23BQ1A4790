EVAL_API_BASE_URL=http://4.224.186.213/evaluation-service
DEPOTS_ENDPOINT=depots
TASK_LIST_ENDPOINT=vehicles
# The evaluation API exposes `/vehicles` (TaskID/Duration/Impact). Keep this set unless you use another endpoint.
# The DEPOTS endpoint path (default `depots`) will be combined with EVAL_API_BASE_URL to form:
# http://<host>/evaluation-service/depots
DEPOT_TASKS_ENDPOINT=depots/{depot_id}/tasks
EVAL_API_AUTH_HEADER_NAME=Authorization
EVAL_API_AUTH_HEADER_VALUE=Bearer <token>
